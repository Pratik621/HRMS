{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.js",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/missing-clockout",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/daily-absent",
      "schedule": "29 18 * * *"
    },
    {
      "path": "/api/cron/weekly-cleanup",
      "schedule": "30 20 * * 6"
    },
    {
      "path": "/api/cron/monthly-accrual",
      "schedule": "30 19 1 * *"
    }
  ]
}